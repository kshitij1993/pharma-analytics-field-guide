  "cards": [
    {
      "dot": "emerald",
      "title": "Medallion path",
      "items": [
        "Bronze is a 1:1 COPY of the generator's Parquet exports with dtype-inferred schemas, no cleanup",
        "Silver (dbt tables) cleans and conforms three fact sources and builds the HCP golden record",
        "Gold currently holds one model, patient_journey_funnel"
      ]
    },
    {
      "dot": "rose",
      "title": "HCP identity resolution",
      "items": [
        "hcp_master carries about 8% duplicate HCPs with blank or mistyped NPIs, so NPI is not a safe join key",
        "Silver normalizes, fuzzy-matches with pg_trgm, and assigns golden IDs; rx_audit and claims join through the xref"
      ]
    },
    {
      "dot": "amber",
      "title": "Not wired yet at this revision",
      "items": [
        "sell_in, crm_calls, rep_roster, formulary and alignment (5 of 9 Bronze tables) load but no dbt model reads them",
        "Gold recomputes the claims patient token with pgcrypto to link hub patients to claims"
      ]
    }
  ]
